# 复制为 .env 或直接在青龙面板逐条添加；不要把真实 Cookie / Key 提交到仓库。

# ---- 社区登录 ----
# 浏览器登录 https://club.ugnas.com/ 后 F12 复制完整 Cookie。演练模式可不填。
UGREEN_COOKIE=

# ---- 运行开关 ----
# 1 = 演练（默认，不发帖）；0 = 真正发送回复
UGREEN_DRY_RUN=1
UGREEN_FORUM_FIDS=10,9,13,14,83,12
UGREEN_HOURS=24
# 每个板块各取最新几篇（六个板块交错进入 AI 判断，避免一个板块占满名额）
UGREEN_PER_FORUM_LIMIT=4
# 允许「纯表情 / 表情+短语」这类鼓励式回复；0 则只发文字回复
UGREEN_ALLOW_EMOJI_REPLY=1
UGREEN_MAX_DETAIL=30
UGREEN_MAX_REPLIES=5
UGREEN_MIN_DELAY=60
UGREEN_MAX_DELAY=180
UGREEN_REQUEST_DELAY=1.0
UGREEN_TIMEOUT=30
UGREEN_SKIP_EVENTS=0
UGREEN_USE_LIST_FALLBACK=1
# 仅控制演练模式是否用本地模板演示；实发模式强制要求 AI_API_KEY，不允许模板发帖
UGREEN_LOCAL_FALLBACK=1
UGREEN_NOTIFY=1
UGREEN_MARK_STATE=1
UGREEN_DEBUG=0
UGREEN_AUTO_INSTALL_DEPS=1
# UGREEN_STATE_DIR=/ql/data/scripts
# UGREEN_SUCCESS_MARKERS=succeedhandle,回复发布成功,帖子回复成功,发布成功

# ---- AI 大模型（OpenAI 兼容接口）----
# 最小配置只要三项：baseURL / apiKey / model
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=
AI_MODEL=deepseek-ai/DeepSeek-V3

# 也可一行指定厂商预设，自动填好 baseURL 与模型（显式变量始终优先）
# 可选：siliconflow / deepseek / openai / moonshot / dashscope / zhipu /
#       ollama / lmstudio / custom
# AI_PROVIDER=deepseek

# 兼容的常见变量名，按优先级取「第一个非空值」（青龙里已有别的脚本变量也能复用）
#   baseURL : AI_BASE_URL > UGREEN_AI_BASE_URL > OPENAI_BASE_URL > OPENAI_API_BASE
#           > LLM_BASE_URL > AI_API_BASE > SILICONFLOW_BASE_URL > DEEPSEEK_BASE_URL
#   apiKey  : AI_API_KEY > UGREEN_AI_API_KEY > OPENAI_API_KEY > LLM_API_KEY
#           > AI_TOKEN > SILICONFLOW_API_KEY > SF_API_KEY > DEEPSEEK_API_KEY > API_KEY
#   model   : AI_MODEL > UGREEN_AI_MODEL > OPENAI_MODEL > LLM_MODEL > AI_MODEL_NAME
#           > SILICONFLOW_MODEL > SF_MODEL > DEEPSEEK_MODEL

# 完整地址优先于 baseURL 拼接：适配 Azure / 自建网关 / 带 query 的端点
# AI_ENDPOINT=https://xxx.openai.azure.com/openai/deployments/gpt4/chat/completions?api-version=2024-02-01
# AI_CHAT_PATH=chat/completions       # 只改路径后缀时用这个
# AI_AUTH_HEADER=Authorization        # Azure 等可改成 api-key
# AI_AUTH_SCHEME=Bearer               # 留空 = 直接把 Key 作为该请求头的值

# 请求参数
AI_TIMEOUT=120
AI_BATCH_SIZE=5
AI_TEMPERATURE=0.6
AI_MAX_TOKENS=2400
# AI_TOP_P=0.9                       # 留空则不传该字段
AI_RETRIES=3
AI_JSON_MODE=1                      # 端点不支持 response_format 时会自动降级
AI_ENABLED=1                        # 0 = 关闭 AI（实发模式会拒绝发帖）

# 厂商私有参数 / 自定义请求头 / 提示词（前两项必须是 JSON 对象）
# AI_EXTRA_BODY={"enable_thinking":false}
# AI_EXTRA_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"ugreen"}
# AI_PROMPT_EXTRA=所有回复都不要出现英文缩写
# AI_SYSTEM_PROMPT=...              # 整段替换内置系统提示词
# AI_SYSTEM_PROMPT_FILE=/ql/data/scripts/my_prompt.txt

# 配置自检（不访问社区、不发帖、不写状态）
#   python ugreen_ai_reply.py --show-config   # 打印生效配置，Key 脱敏
#   python ugreen_ai_reply.py --test-ai       # 发一条最小请求验证连通性

# 其他厂商示例：
#   DeepSeek 官方 : AI_BASE_URL=https://api.deepseek.com/v1   AI_MODEL=deepseek-chat
#   OpenAI        : AI_BASE_URL=https://api.openai.com/v1     AI_MODEL=gpt-4o-mini
#   通义千问      : AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
#   本地 Ollama   : AI_BASE_URL=http://127.0.0.1:11434/v1     AI_MODEL=qwen2.5:14b  AI_API_KEY=ollama

# ---- 通知（三选一，青龙优先自动用 sendNotify）----
# QYWX_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# QYWX_AM=corpid,corpsecret,touser,agentid
