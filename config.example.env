# 复制为 .env 或直接在青龙面板逐条添加；不要把真实 Cookie / Key 提交到仓库。

# ---- 社区登录 ----
# 浏览器登录 https://club.ugnas.com/ 后 F12 复制完整 Cookie。演练模式可不填。
UGREEN_COOKIE=

# ---- 运行开关 ----
# 1 = 演练（默认，不发帖）；0 = 真正发送回复
UGREEN_DRY_RUN=1

# ---- 帖子来源 ----
# 1 = 论坛导读（默认）：https://club.ugnas.com/forum.php?mod=guide
#     不区分板块、全站按发布时间倒序，覆盖的板块比下面配的更全
# 0 = 改回按下面的板块 RSS 抓
UGREEN_USE_GUIDE=1
UGREEN_GUIDE_PAGES=1              # 导读抓几页（每页 50 条）
UGREEN_GUIDE_LIMIT=20             # 导读模式下最多取最新多少篇送进 AI 判断
# 以下两项仅在 UGREEN_USE_GUIDE=0 时生效
UGREEN_FORUM_FIDS=10,9,13,14,83,12
UGREEN_PER_FORUM_LIMIT=4           # 每个板块各取最新几篇（六个板块交错进入 AI 判断）

UGREEN_HOURS=24
# 允许「纯表情 / 表情+短语」这类鼓励式回复；0 则只发文字回复
UGREEN_ALLOW_EMOJI_REPLY=1
UGREEN_MAX_DETAIL=30
UGREEN_MAX_REPLIES=5
# 每天最多发几条（跨运行累计，按本地自然日）；0 = 不限制
# 计数写在状态文件 ugreen_state.json 的 daily 字段里，只有实发成功才计数；
# 用满后本次运行直接跳过（连帖子都不抓）。演练模式不占用配额。
UGREEN_DAILY_QUOTA=10
UGREEN_MIN_DELAY=60
UGREEN_MAX_DELAY=180
UGREEN_REQUEST_DELAY=1.0
UGREEN_TIMEOUT=30
UGREEN_SKIP_EVENTS=0
UGREEN_USE_LIST_FALLBACK=1
# 仅控制演练模式是否用本地模板演示；实发模式强制要求 AI_API_KEY，不允许模板发帖
UGREEN_LOCAL_FALLBACK=1
UGREEN_NOTIFY=1
UGREEN_MARK_STATE=1
UGREEN_DEBUG=0
UGREEN_AUTO_INSTALL_DEPS=1
# UGREEN_STATE_DIR=/ql/data/scripts
# UGREEN_SUCCESS_MARKERS=succeedhandle,回复发布成功,帖子回复成功,发布成功

# ---- AI 大模型（OpenAI 兼容接口）----
# 最小配置只要三项：baseURL / apiKey / model
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=
AI_MODEL=deepseek-ai/DeepSeek-V3

# 也可一行指定厂商预设，自动填好 baseURL 与模型（显式变量始终优先）
# 可选：siliconflow / deepseek / openai / moonshot / dashscope / zhipu /
#       ollama / lmstudio / custom
# AI_PROVIDER=deepseek

# 兼容的常见变量名，按优先级取「第一个非空值」（青龙里已有别的脚本变量也能复用）
#   baseURL : AI_BASE_URL > UGREEN_AI_BASE_URL > OPENAI_BASE_URL > OPENAI_API_BASE
#           > LLM_BASE_URL > AI_API_BASE > SILICONFLOW_BASE_URL > DEEPSEEK_BASE_URL
#   apiKey  : AI_API_KEY > UGREEN_AI_API_KEY > OPENAI_API_KEY > LLM_API_KEY
#           > AI_TOKEN > SILICONFLOW_API_KEY > SF_API_KEY > DEEPSEEK_API_KEY > API_KEY
#   model   : AI_MODEL > UGREEN_AI_MODEL > OPENAI_MODEL > LLM_MODEL > AI_MODEL_NAME
#           > SILICONFLOW_MODEL > SF_MODEL > DEEPSEEK_MODEL

# 完整地址优先于 baseURL 拼接：适配 Azure / 自建网关 / 带 query 的端点
# AI_ENDPOINT=https://xxx.openai.azure.com/openai/deployments/gpt4/chat/completions?api-version=2024-02-01
# AI_CHAT_PATH=chat/completions       # 只改路径后缀时用这个
# AI_AUTH_HEADER=Authorization        # Azure 等可改成 api-key
# AI_AUTH_SCHEME=Bearer               # 留空 = 直接把 Key 作为该请求头的值

# 请求参数
AI_TIMEOUT=120
AI_BATCH_SIZE=5
AI_TEMPERATURE=0.6
AI_MAX_TOKENS=131072                 # 单次最大输出 token(128K)；设 0 = 不限制(不带该字段)
AI_MAX_TOKENS_CAP=1048576            # 输出被截断时自适应放宽的天花板(1M)；0 = 不设顶
# AI_TOP_P=0.9                       # 留空则不传该字段
AI_RETRIES=3
AI_JSON_MODE=1                      # 端点不支持 response_format 时会自动降级
AI_BATCH_FALLBACK=1                 # 整批解析失败时对缺失帖子逐篇重试
# AI_DISABLE_THINKING=1             # 不设时按模型名自动判断(Xing/Qwen3/R1 等默认关闭思考)
AI_ENABLED=1                        # 0 = 关闭 AI（实发模式会拒绝发帖）

# 厂商私有参数 / 自定义请求头 / 提示词（前两项必须是 JSON 对象）
# AI_EXTRA_BODY={"enable_thinking":false}
# AI_EXTRA_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"ugreen"}
# AI_PROMPT_EXTRA=所有回复都不要出现英文缩写
# AI_SYSTEM_PROMPT=...              # 整段替换内置系统提示词
# AI_SYSTEM_PROMPT_FILE=/ql/data/scripts/my_prompt.txt

# 配置自检（不访问社区、不发帖、不写状态）
#   python ugreen_ai_reply.py --show-config   # 打印生效配置，Key 脱敏
#   python ugreen_ai_reply.py --test-ai       # 发一条最小请求验证连通性

# 其他厂商示例：
#   DeepSeek 官方 : AI_BASE_URL=https://api.deepseek.com/v1   AI_MODEL=deepseek-chat
#   OpenAI        : AI_BASE_URL=https://api.openai.com/v1     AI_MODEL=gpt-4o-mini
#   通义千问      : AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
#   本地 Ollama   : AI_BASE_URL=http://127.0.0.1:11434/v1     AI_MODEL=qwen2.5:14b  AI_API_KEY=ollama

# ---- A：已有楼层上下文 ----
# 把详情页里别人已回复的内容一起喂给模型；楼主说「已解决」则跳过该帖
UGREEN_FETCH_REPLIES=1
UGREEN_MAX_FLOORS=8
UGREEN_FLOOR_CHARS=300
UGREEN_SKIP_SOLVED=1

# ---- B：保守模式（防止凭空编版本号 / 假装官方）----
# 无证据却报具体版本号、下确定性结论、引用不存在的证据编号 -> 直接拦截
UGREEN_CONSERVATIVE=1
UGREEN_REQUIRE_EVIDENCE=1

# ---- 已回复帖的重访（默认不再回复，除非被点名 / 出现更优解）----
# 1 = 允许回头看已回复的帖子；命中触发条件才真的再回一次
UGREEN_RECHECK_REPLIED=1
UGREEN_RECHECK_LIMIT=3          # 每次最多回头看几篇
UGREEN_REVISIT_HOURS=168        # 只回溯最近多少小时（7 天）内回复过的
# 你的社区用户名：有人 @你 或提到你时会触发重访；留空则只靠「更优解」触发
# UGREEN_MY_USERNAME=你的用户名

# ---- 水帖 / 学习点赞 / 图文 ----
# 水贴（签到、闲聊、打卡）可以用一句简短回应或表情包，不会当成技术咨询
UGREEN_ALLOW_CASUAL_REPLY=1
UGREEN_MAX_CASUAL=1             # 每次运行最多几条水帖回复，防止刷屏
# 分享帖 / 自荐帖 / 教程帖（【自荐】【分享】实战 教程…）回一句学习、点赞
UGREEN_ALLOW_LEARN_REPLY=1
UGREEN_MAX_LEARN=3              # 每次运行最多几条学习点赞型回复，防止刷屏
# 图文：只允许白名单里的论坛表情代码，模型不能自由塞图片链接
UGREEN_ALLOW_MEDIA=1
UGREEN_MEDIA_CODES=[赞],[图片],[示意图],[加油],[鼓掌],[哈哈],[谢谢],[握手]
# 日志里「最新：xxx」的标题显示长度；0 = 完整显示（默认不截断），截断时带 …
# UGREEN_LOG_TITLE_CHARS=40

# ---- D：检索（默认查绿联官方知识库，零配置可用）----
# 来源可选：ugnas-kb / local / site / tavily / bing / baidu / searxng / custom
# site = Discuz 站内搜索，游客态会被论坛拒绝，需有效 UGREEN_COOKIE
UGREEN_SEARCH=1
UGREEN_SEARCH_PROVIDERS=ugnas-kb,tavily,baidu
UGREEN_SEARCH_MAX_QUERIES=8
UGREEN_SEARCH_MAX_EVIDENCE=4
UGREEN_SEARCH_SNIPPET_CHARS=400
UGREEN_SEARCH_TOTAL_CHARS=1800
UGREEN_SEARCH_MIN_RELEVANCE=0.12   # 只丢明显跑题的，其余交给模型判断
UGREEN_SEARCH_LANGUAGE=zh-CN
UGREEN_SEARCH_DELAY=0.8
UGREEN_SEARCH_TIMEOUT=20
UGREEN_KB_DETAIL=1                 # 再取一次文章全文，证据更实
UGREEN_KB_DETAIL_LIMIT=1

# 本地知识库：把 .md/.txt 放进 knowledge/，并把 local 加进 providers
# UGREEN_LOCAL_KB_DIR=./knowledge
# UGREEN_SEARCH_PROVIDERS=ugnas-kb,local

# 可选的联网检索（按需启用，不配就等于不用；知识库查不到证据时才联网补查）
# TAVILY_API_KEY=tvly-xxx
# BING_SEARCH_KEY=xxxxxxxx
# SEARXNG_URL=http://127.0.0.1:8080

# 百度（千帆 AI 搜索 / AppBuilder），端点、鉴权头、结果路径都可改
# BAIDU_SEARCH_KEY=xxxxxxxx            # 也可用 QIANFAN_API_KEY / APPBUILDER_TOKEN
# BAIDU_SEARCH_URL=https://qianfan.baidubce.com/v2/ai_search/web_search
# BAIDU_SEARCH_ENGINE=baidu_search
# BAIDU_SEARCH_TOP_K=5
# BAIDU_SEARCH_RESULTS_PATH=data.references   # 留空则自动探测常见返回结构
# BAIDU_AUTH_HEADER=Authorization         # 改成 api-key 等
# BAIDU_AUTH_SCHEME=Bearer                # 留空 = 直接把 Key 作为该头的值
# BAIDU_SEARCH_HEADERS={"X-App-Id":"xxx"}

# 自定义检索端点（任何返回 JSON 的搜索 API）
# UGREEN_SEARCH_CUSTOM_URL=https://search.example/api?q={query}
# UGREEN_SEARCH_RESULTS_PATH=data.items
# UGREEN_SEARCH_TITLE_FIELD=title
# UGREEN_SEARCH_SNIPPET_FIELD=content
# UGREEN_SEARCH_URL_FIELD=url
# UGREEN_SEARCH_CUSTOM_HEADERS={"X-Api-Key":"xxx"}

# 只跑检索的诊断命令（不访问社区、不调模型、不发帖）
#   python ugreen_ai_reply.py --test-search "硬盘休眠"

# ---- 通知（三选一，青龙优先自动用 sendNotify）----
# QYWX_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# QYWX_AM=corpid,corpsecret,touser,agentid
